#
# Environment configuration for grafana/docker-otel-lgtm
# ------------------------------------------------------
# This file is loaded by docker-compose (see docker-compose.yaml).
# All variables are optional; uncomment and adjust as needed.
#

########################################
# Logging for internal components
########################################

# Enable detailed logging per component (for troubleshooting):
ENABLE_LOGS_GRAFANA=true
ENABLE_LOGS_LOKI=true
ENABLE_LOGS_PROMETHEUS=true
ENABLE_LOGS_TEMPO=true
#ENABLE_LOGS_PYROSCOPE=true
ENABLE_LOGS_OTELCOL=true

# Or enable logging for all of the above at once:
#ENABLE_LOGS_ALL=true


########################################
# Exporting data to an external OTLP backend
########################################

# If set, the OpenTelemetry Collector inside docker-otel-lgtm will
# forward logs/metrics/traces to this OTLP/HTTP endpoint instead of
# (or in addition to) storing everything locally.
#
# Example for Grafana Cloud (replace with your values):
#OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-YOUR_STACK.grafana.net/otlp

# OTLP headers for authentication (example for Grafana Cloud):
#OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic YOUR_BASE64_API_KEY_OR_TOKEN


########################################
# OBI (eBPF auto-instrumentation)
########################################

# Enable OpenTelemetry eBPF Instrumentation (OBI).
# Requires: Linux kernel 5.8+ with BTF support.
#
# When enabled, you may also need to set `pid: "host"` and `privileged: true`
# on the `lgtm` service in docker-compose.yaml (mirroring run-lgtm.sh).
#
#ENABLE_OBI=true

# Target specific applications (examples):
#OBI_TARGET=java           # instrument all Java processes
#OBI_TARGET=python         # instrument all Python processes
#OBI_TARGET=myapp          # match executable name "myapp"

# Override ports to monitor (native OBI env var):
#OTEL_EBPF_OPEN_PORT=8080,9090


########################################
# Grafana plugins
########################################

# Pre-install Grafana plugins into the bundled Grafana instance.
# Comma-separated list, e.g. "grafana-clock-panel,grafana-piechart-panel"
#GF_PLUGINS_PREINSTALL=grafana-clock-panel

